POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=twitch_docs_rag
POSTGRES_USER=twitch_docs_rag
POSTGRES_PASSWORD=change-me

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
WEAVIATE_URL=http://weaviate:8080

DJANGO_SECRET_KEY=change-me

VOYAGE_API_KEY=change-me

GROQ_API_KEY=change-me
GROQ_MODEL=openai/gpt-oss-120b

# Minimum top retrieval score an answer needs; below it the API returns the fixed fallback.
# Calibrated against a 20-question labeled set (10 in-scope, 10 out-of-scope) via
# `manage.py calibrate_threshold` — see docs/calibration_questions.json. Re-run if the corpus or
# retrieval config changes meaningfully.
RELEVANCE_THRESHOLD=0.90
